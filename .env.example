# Copy to .env for `make run` (local dev against docker-compose).
ENV=development
DATABASE_URL=postgres://files:files@127.0.0.1:5442/files?sslmode=disable
FILES_PUBLIC_URL=http://localhost:8080
INTERNAL_TOKEN=dev-internal-token
FILES_GUEST_SECRET=dev-guest-secret-0123456789
# AUTH_ISSUER=http://localhost:3002
# AUTH_JWKS_URL=          # default: $AUTH_ISSUER/.well-known/jwks.json
# BOSON_CONFIG=./config/boson.yaml

# Storage (the files: section of BOSON_CONFIG wins over these)
FILES_STORAGE_DRIVER=local
FILES_DATA_DIR=./data/files
FILES_STORAGE_MIN_FREE=2GB
# FILES_STORAGE_DRIVER=s3
# FILES_S3_ENDPOINT=http://127.0.0.1:9000
# FILES_S3_BUCKET=files
# FILES_S3_ACCESS_KEY=minio
# FILES_S3_SECRET_KEY=minio-secret
# FILES_STORAGE_CAPACITY=15GB
